#!/usr/bin/env ruby
# frozen_string_literal: true

# Manual live-API check. NOT part of the test suite. Usage (PowerShell):
#   $env:PSN_NPSSO = "<token>"; ruby bin/smoke
# or with a saved refresh token:
#   $env:PSN_REFRESH_TOKEN = "<token>"; ruby bin/smoke

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "psn_client"

npsso = ENV.fetch("PSN_NPSSO", nil)
refresh = ENV.fetch("PSN_REFRESH_TOKEN", nil)
abort "Set PSN_NPSSO or PSN_REFRESH_TOKEN" unless npsso || refresh

client = npsso ? PSN::Client.new(npsso: npsso) : PSN::Client.new(refresh_token: refresh)

def section(name)
  puts "\n== #{name}"
  yield
rescue PSN::Error => e
  puts "FAILED: #{e.class}: #{e.message}"
  puts "        response: #{e.response.inspect}" if e.response
end

section("Trophy summary") do
  s = client.trophies.summary
  puts "level #{s.level}, counts #{s.earned_counts}"
end

section("5 most recent games") do
  client.games.played.first(5).each { |g| puts "#{g.name} [#{g.platform}] plays=#{g.play_count}" }
end

section("5 trophy titles") do
  client.trophies.titles.first(5).each { |t| puts "#{t.name} (#{t.progress}%)" }
end

section("5 transactions") do
  client.store.transactions.first(5).each { |t| puts "#{t.date} #{t.description} #{t.amount} #{t.currency}" }
end

section("5 entitlements") do
  client.store.entitlements.first(5).each { |e| puts "#{e.name} [#{e.platform}] #{e.acquired_at}" }
end

section("Profile") do
  p = client.profiles.find
  puts "#{p.online_id} plus=#{p.plus?} level=#{p.trophy_summary&.level} avatar=#{p.avatar_url}"
end

section("5 library titles") do
  client.games.library.first(5).each { |g| puts "#{g.name} [#{g.platform}] sub=#{g.subscription_service || '-'}" }
end

section("5 purchased games") do
  client.games.purchased.first(5).each { |g| puts "#{g.name} [#{g.platform}] downloadable=#{g.downloadable?}" }
end

section("5 wishlist items") do
  client.store.wishlist.first(5).each do |w|
    puts "#{w.name} #{w.concept? ? '[concept]' : w.platforms.join('/')} #{w.discounted_price || '-'}"
  end
end

section("Trophy title summary for 2 recent games") do
  ids = client.games.played.first(2).map(&:title_id)
  client.trophies.title_summary(title_ids: ids).each do |s|
    s.trophy_titles.each { |t| puts "#{s.np_title_id}: #{t.name} #{t.progress}%" }
  end
end

section("Trophy groups for most recent trophy title") do
  title = client.trophies.titles.first(1).first
  client.trophies.groups(np_communication_id: title.np_communication_id,
                         platform: title.platform).each do |g|
    puts "#{g.group_id}: #{g.name} #{g.progress}%"
  end
end

section("Search: 3 games matching 'astro'") do
  client.search.games("astro").first(3).each do |g|
    puts "#{g.name} [#{g.platforms.join('/')}] #{g.price&.discounted_price || '-'}"
  end
end

section("Search: 3 users matching 'test'") do
  client.search.users("test").first(3).each { |u| puts "#{u.online_id} plus=#{u.ps_plus?}" }
end

section("Catalog: product detail, pricing and rating via search") do
  hit = client.search.games("astro bot").first(1).first
  product = client.catalog.product(hit.id)
  puts "#{product.name} by #{product.publisher} (#{product.content_rating})"
  puts "price: #{client.catalog.pricing(product.concept_id)&.discounted_price || '-'}"
  rating = client.catalog.product_rating(hit.id)
  puts "rating: #{rating&.average_display} from #{rating&.total} ratings"
end

section("Catalog: 3 newest PS5 games") do
  client.catalog.category(:ps5_games).first(3).each { |g| puts "#{g.name} #{g.price&.base_price || '-'}" }
end

section("Catalog: add-ons for most recent played game") do
  id = client.games.played.first(1).first.title_id
  client.catalog.add_ons(id).first(3).each { |a| puts "#{a.name} #{a.price&.discounted_price || '-'}" }
end

section("Catalog: concept detail slices (rating, media, legal, compat)") do
  hit = client.search.games("astro bot").first(1).first
  concept_id = client.catalog.product(hit.id).concept_id
  rating = client.catalog.content_rating(concept_id)
  puts "rating: #{rating&.description} (#{rating&.authority})"
  media = client.catalog.media(concept_id)
  puts "media: #{media.size} assets, first: #{media.first&.role} #{media.first&.type}"
  legal = client.catalog.legal_text(concept_id)
  puts "legal: #{legal.notices.size} notices, privacy=#{legal.privacy_policy || '-'}"
  compat = client.catalog.compatibility_notices(concept_id)
  puts "compat: #{compat.compatibility.size} entries, accessibility: #{compat.accessibility.size}"
end

section("Catalog: editions and concept_for_product") do
  hit = client.search.games("astro bot").first(1).first
  concept = client.catalog.concept_for_product(hit.id)
  puts "concept: #{concept.id} #{concept.name}"
  client.catalog.editions(concept.id).each do |e|
    puts "#{e.name} #{e.cta_type} #{e.price&.discounted_price || '-'}"
  end
end

section("Catalog: 3 add-ons by concept (AC Odyssey)") do
  hit = client.search.games("assassin's creed odyssey").first(1).first
  concept = client.catalog.concept_for_product(hit.id)
  client.catalog.add_ons_by_concept(concept.id).first(3).each do |a|
    puts "#{a.name} #{a.price&.discounted_price || '-'}"
  end
end

section("Catalog: PS Plus offers (essential tier)") do
  client.catalog.plus_offers.each { |o| puts "#{o.title} #{o.discounted_price} trial=#{o.trial?}" }
end

section("Friends who play (PROVISIONAL, raw body)") do
  hit = client.search.games("astro bot").first(1).first
  concept = client.catalog.concept_for_product(hit.id)
  puts client.games.friends_who_play(concept.id).inspect[0, 500]
end

section("Game Help for ASTRO's PLAYROOM (NPWR20188_00)") do
  infos = client.trophies.game_help_availability(np_communication_id: "NPWR20188_00").first(3)
  infos.each { |t| puts "trophy #{t.trophy_id} #{t.help_type} #{t.uds_object_id}" }
  help = client.trophies.game_help(np_communication_id: "NPWR20188_00", trophies: infos.first(1))
  puts "access=#{help.access?} tips=#{help.tips.flat_map(&:contents).map(&:display_name).join(', ')}"
end

section("Presence") do
  p = client.social.presence
  puts "availability=#{p.availability} online=#{p.online?} platform=#{p.platform || '-'}"
  p.now_playing.each { |t| puts "playing: #{t.name} [#{t.format}]" }
end

section("5 friends / requests / blocked") do
  puts "friends: #{client.social.friends.first(5).to_a.join(', ')}"
  puts "requests: #{client.social.friend_requests.first(5).to_a.inspect}"
  puts "blocked: #{client.social.blocked.first(5).to_a.inspect}"
end

section("Friendship summary (PROVISIONAL, raw body; set PSN_FRIEND_ID)") do
  friend = ENV.fetch("PSN_FRIEND_ID", nil)
  if friend
    puts client.social.friendship(friend).inspect[0, 500]
  else
    puts "skipped (set PSN_FRIEND_ID to a friend's online ID)"
  end
end

section("Available to play (PROVISIONAL, raw body)") do
  puts client.social.available_to_play.inspect[0, 500]
end

section("Devices") do
  client.devices.all.each { |d| puts "#{d.device_type} #{d.activation_type} activated=#{d.activated_at}" }
end

section("Console storage (PROVISIONAL, raw body)") do
  puts client.devices.storage.inspect[0, 500]
end

section("Shareable profile link") do
  link = client.profiles.shareable_link
  puts "#{link.url} qr=#{link.image_url}"
end

section("Profile region") do
  puts client.profiles.find.region.inspect
end

section("Catalog: concept for most recent played title (PROVISIONAL, raw body)") do
  id = client.games.played.first(1).first.title_id
  puts client.catalog.concept_for_title(id).inspect[0, 500]
end

puts "\nRefresh token (persist for next session):"
puts client.refresh_token
