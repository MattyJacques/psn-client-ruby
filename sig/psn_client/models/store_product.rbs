module PSN
  class StoreProduct < ::Data
    def self.from_api: (::Hash[String, untyped] hash) -> StoreProduct
    def self.new: (**untyped) -> instance

    attr_reader name: String?
    attr_reader id: String?
    attr_reader np_title_id: String?
    attr_reader invariant_name: String?
    attr_reader concept_id: String?
    attr_reader platforms: ::Array[untyped]
    attr_reader publisher: String?
    attr_reader release_date: Time?
    attr_reader genres: ::Array[untyped]
    attr_reader classification: String?
    attr_reader localized_classification: String?
    attr_reader edition: String?
    attr_reader short_description: String?
    attr_reader description: String?
    attr_reader content_rating: String?
    attr_reader image_url: String?
    attr_reader raw: ::Hash[String, untyped]
  end
end
