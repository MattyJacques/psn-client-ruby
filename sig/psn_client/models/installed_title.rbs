module PSN
  class InstalledTitle < ::Data
    def self.from_api: (::Hash[String, untyped] hash) -> InstalledTitle
    def self.new: (**untyped) -> instance

    attr_reader name: String?
    attr_reader title_id: String?
    attr_reader np_title_id: String?
    attr_reader concept_id: String?
    attr_reader platform: String?
    attr_reader size_bytes: Integer?
    attr_reader last_played_at: Time?
    attr_reader version: String?
    attr_reader raw: ::Hash[String, untyped]
  end
end
