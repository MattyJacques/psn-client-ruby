module PSN
  class WishlistItem < ::Data
    def self.from_api: (::Hash[String, untyped] hash) -> WishlistItem
    def self.new: (**untyped) -> instance

    attr_reader name: String?
    attr_reader id: String?
    attr_reader concept: bool
    attr_reader platforms: ::Array[untyped]
    attr_reader image_url: String?
    attr_reader classification: String?
    attr_reader localized_classification: String?
    attr_reader base_price: String?
    attr_reader discounted_price: String?
    attr_reader discount_text: String?
    attr_reader free: bool
    attr_reader tied_to_subscription: bool
    attr_reader exclusive: bool
    attr_reader service_branding: String?
    attr_reader upsell_service_branding: String?
    attr_reader upsell_text: String?
    attr_reader sku_id: String?
    attr_reader raw: ::Hash[String, untyped]

    def concept?: () -> bool
    def free?: () -> bool
    def tied_to_subscription?: () -> bool
    def exclusive?: () -> bool
  end
end
