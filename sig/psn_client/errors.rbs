module PSN
  class Error < StandardError
    attr_reader response: ::Hash[Symbol, untyped]?

    def initialize: (?String? message, ?response: ::Hash[Symbol, untyped]?) -> void
  end

  class AuthenticationError < Error
  end

  class PrivacyError < Error
  end

  class NotFoundError < Error
  end

  class APIError < Error
  end

  class AccessDeniedError < Error
  end

  class RateLimitError < Error
    attr_reader retry_after: Integer?

    def initialize: (?String? message, ?response: ::Hash[Symbol, untyped]?, ?retry_after: Integer?) -> void
  end
end
